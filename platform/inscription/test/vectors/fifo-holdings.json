{
 "version": 1,
 "rule": "Concatenate the sats of every input in input order into one stream. Fill outputs in order; each output takes the next contiguous chunk of exactly its value. Whatever is left at the tail is the fee. An inscription at offset o of input k sits at stream position (sum of values of inputs before k) + o.",
 "spec": "docs/FIFO-SIMULATOR.md",
 "implementation": "tools/stacker/blockspace_stacker/ord_sim.py",
 "conventions": {
  "sat_ranges": "list of [start, end) half-open sat-number ranges, or {\"unknown\": n} for n sats of unknown numbering; may be omitted/null for a wholly opaque input",
  "placements.output": "zero-based output index, or the string \"FEE\" when burned",
  "placements.offset": "offset within that output; for \"FEE\", distance past the last output",
  "placements.sat": "sat number, or null when the source range is unknown",
  "out_ranges": "per output, the list of ranges (same encoding as sat_ranges) it receives"
 },
